<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rutwej Interaction Notes</title>
    <style>
        /* Existing styles from IErrandsNotes.html */
        :root {
            --background-color: #f0f4f9;
            --text-color: #2d3748;
            --box-background: rgba(255, 255, 255, 0.9);
            --box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            --input-border: #e2e8f0;
            --input-focus-border: #4c51bf;
            --input-focus-shadow: rgba(76, 81, 191, 0.3);
            --primary-color: #4c51bf;
            --secondary-color: #718096;
            --success-color: #48bb78;
            --danger-color: #f56565;
            --glass-background: rgba(255, 255, 255, 0.2);
            --glass-border: rgba(255, 255, 255, 0.3);
            --transition-speed: 0.3s;
        }

        [data-theme="dark"] {
            --background-color: #1a202c;
            --text-color: #f7fafc;
            --box-background: rgba(45, 55, 72, 0.9);
            --box-shadow: 0 8px 32px rgba(255, 255, 255, 0.1);
            --input-border: #4a5568;
            --input-focus-border: #667eea;
            --input-focus-shadow: rgba(102, 126, 234, 0.3);
            --glass-background: rgba(45, 55, 72, 0.3);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--background-color);
            color: var(--text-color);
            transition: background-color var(--transition-speed), color var(--transition-speed);
        }

        .container {
            display: flex;
            gap: 20px;
            max-width: 1800px;
            margin: 40px auto;
            padding: 20px;
        }

        .interaction-box {
            flex: 1;
            background: var(--box-background);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            padding: 30px;
            border-radius: 20px;
            box-shadow: var(--box-shadow);
            transition: all var(--transition-speed);
        }

        h2 {
            text-align: center;
            font-size: 32px;
            margin-bottom: 30px;
            color: var(--primary-color);
            font-weight: 700;
        }

        ul {
            list-style-type: none;
            padding: 0;
        }

        li {
            margin: 20px 0;
            font-weight: 500;
        }

        input, textarea, select {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: 1px solid var(--input-border);
            border-radius: 10px;
            transition: all var(--transition-speed);
            background-color: var(--box-background);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }

        input:focus, textarea:focus, select:focus {
            border-color: var(--input-focus-border);
            box-shadow: 0 0 8px var(--input-focus-shadow);
            outline: none;
        }

        .btn-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 25px;
        }

        button {
            padding: 12px 24px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-refresh {
            background-color: var(--danger-color);
            color: Black;
        }

        .btn-copy {
            background-color: var(--success-color);
            color: white;
        }

        button:hover {
            transform: translateY(-2px);
            opacity: 0.9;
        }

        .pnr-container {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .theme-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 12px 20px;
            background-color: var(--box-background);
            color: var(--text-color);
            border: 1px solid var(--input-border);
            border-radius: 10px;
            cursor: pointer;
            transition: all var(--transition-speed);
            backdrop-filter: blur(10px);
        }

        .theme-toggle:hover {
            background-color: var(--primary-color);
            color: Black;
            border-color: var(--primary-color);
        }

        .template-select {
            margin-bottom: 20px;
        }

        .editable-solution {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            line-height: 1.6;
            min-height: 120px;
            resize: vertical;
        }

        .word-count {
            font-size: 12px;
            color: var(--secondary-color);
            text-align: right;
            margin-top: 5px;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .interaction-box {
            animation: fadeIn 0.6s ease-out;
        }

        /* Glassmorphism effect */
        .interaction-box {
            background: var(--glass-background);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
        }

        /* Gradient background for body */
        body {
            background: linear-gradient(135deg, var(--background-color), #d1d8e0);
        }

        [data-theme="dark"] body {
            background: linear-gradient(135deg, var(--background-color), #1a202c);
        }

        /* Chat Scripts Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
        }

        .modal-content {
            background: var(--box-background);
            margin: 10% auto;
            padding: 20px;
            border-radius: 10px;
            width: 60%;
            max-height: 70vh;
            overflow-y: auto;
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
        }

        .close {
            float: right;
            font-size: 24px;
            cursor: pointer;
        }

        .text-line {
            background-color: rgba(255, 255, 255, 0.15);
            padding: 15px;
            margin: 10px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text-color);
            font-weight: bold;
        }

        .text-line:hover {
            transform: scale(1.02);
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
        }

        .copy-btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 8px 15px;
            cursor: pointer;
            border-radius: 5px;
            font-weight: bold;
            transition: 0.3s ease;
        }

        .copy-btn:hover {
            background-color: var(--secondary-color);
            color: white;
            transform: scale(1.05);
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <button class="theme-toggle" onclick="toggleTheme()">🌙 Toggle Theme</button>
    <button class="chat-scripts-btn" onclick="openChatScriptsPopup()">📜 Chat Scripts</button>

    <div id="chatScriptsModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeChatScriptsPopup()">&times;</span>
            <h3>Chat Scripts</h3>
            <ul id="chatScriptsList"></ul>
        </div>
    </div>

    <div class="container">
        <!-- First Interaction Box -->
        <div class="interaction-box">
            <h2>Rutwej Errands - Chat 1</h2>
            <div class="btn-container">
                <button class="btn-refresh" onclick="confirmClear(1)">🔄 Refresh Notes</button>
                <button class="btn-copy" onclick="copyToClipboard(1)">📋 Copy to Notes</button>
            </div>
            <ul>
                <li>Order Number: <input type="text" id="orderNumber1"></li>
                <li>Interaction ID: <input type="text" id="interactionId1"></li>
                <li>Contact Person: <input type="text" id="contactPerson1"></li>
                <li>SC Type & PNRs:
                    <div id="pnrList1"></div>
                    <button onclick="addPNR(1)" style="background-color: var(--primary-color); color: white;">➕ Add PNR</button>
                </li>
                <li>Query: 
                    <select id="queryType1" onchange="applyQueryTemplate(1, this.value)">
                        <option value=" "> </option>
                        <option value="Refund">Refund</option>
                        <option value="Rebooking">Rebooking</option>
                        <option value="RefundStatus">Refund Status</option>
                        <option value="RebookingStatus">Rebooking Status</option>
                        <option value="SCConfirmation">SC Confirmation</option>
                        <option value="FlightDetails">Flight Details</option>
                    </select>
                    <textarea id="query1"></textarea>
                </li>
                <li>Solution: 
                    <select class="template-select" onchange="applyTemplate(1, this.value)">
                        <option value="">Select a Template</option>
                        <option value="rebookingOrder">Rebooking Order</option>
                        <option value="supportRebooking">Placing on Support for Rebooking</option>
                        <option value="supportRefund">Placing on Support for Refund</option>
                        <option value="modifyOrder">Modify Order</option>                        
                        <option value="acceptChanges">Accepting the Changes</option>
                        <option value="paxIdle">Pax Idle</option>
                        <option value="sameDayTravel">Same Day Travel or within 24 hours</option>
                        <option value="VIofferedRefund">VI - Offered Refund</option>
                        <option value="refundStatus">Refund Status</option>
                        <option value="rebookingStatus">Rebooking Status</option>
                        <option value="enquiryRebooking">Enquiry about Rebooking</option>
                        <option value="enquiryRefund">Enquiry about Refund</option>
                        <option value="LCCRefund">LCC Refund</option>
                        <option value="checkIn">Check-in</option>
                        <option value="Custom">Custom</option>
                    </select>
                    <textarea id="solution1" class="editable-solution"></textarea>
                </li>
                <li>Segments Removed: 
                    <select id="Segments Removed1">
                        <option value="No">No</option>
                        <option value="Yes">Yes</option>
                    </select> 
                </li>
                <li>No sc Trivial Minor Major Critical Critical/Mct causing/MCT
                <li>Alternatives: <textarea id="alternatives1"></textarea></li>
                <li>ENDO: <textarea id="endo1"></textarea></li>
                <li>OTRS: <textarea id="otrs1"></textarea></li>
                <li>ET: <textarea id="et1"></textarea></li>
            </ul>
        </div>

        <!-- Second Interaction Box -->
        <div class="interaction-box">
            <h2>Rutwej Errands - Chat 2</h2>
            <div class="btn-container">
                <button class="btn-refresh" onclick="confirmClear(2)">🔄 Refresh Notes</button>
                <button class="btn-copy" onclick="copyToClipboard(2)">📋 Copy to Notes</button>
            </div>
            <ul>
                <li>Order Number: <input type="text" id="orderNumber2"></li>                
                <li>Interaction ID: <input type="text" id="interactionId2"></li>
                <li>Contact Person: <input type="text" id="contactPerson2"></li>
                <li>SC Type & PNRs:
                    <div id="pnrList2"></div>
                    <button onclick="addPNR(2)" style="background-color: var(--primary-color); color: white;">➕ Add PNR</button>
                </li>
                <li>Query: 
                    <select id="queryType2" onchange="applyQueryTemplate(2, this.value)">
                        <option value=" "> </option>
                        <option value="Refund">Refund</option>
                        <option value="Rebooking">Rebooking</option>
                        <option value="RefundStatus">Refund Status</option>
                        <option value="RebookingStatus">Rebooking Status</option>
                        <option value="SCConfirmation">SC Confirmation</option>
                        <option value="FlightDetails">Flight Details</option>
                    </select>
                    <textarea id="query2"></textarea>
                </li>
                <li>Solution: 
                    <select class="template-select" onchange="applyTemplate(2, this.value)">
                        <option value="">Select a Template</option>
                        <option value="modifyOrder">Modify Order</option>
                        <option value="rebookingOrder">Rebooking Order</option>
                        <option value="supportRebooking">Placing on Support for Rebooking</option>
                        <option value="supportRefund">Placing on Support for Refund</option>
                        <option value="acceptChanges">Accepting the Changes</option>
                        <option value="paxIdle">Pax Idle</option>
                        <option value="sameDayTravel">Same Day Travel or within 24 hours</option>
                        <option value="VIofferedRefund">VI - Offered Refund</option>
                        <option value="refundStatus">Refund Status</option>
                        <option value="rebookingStatus">Rebooking Status</option>
                        <option value="enquiryRebooking">Enquiry about Rebooking</option>
                        <option value="enquiryRefund">Enquiry about Refund</option>
                        <option value="LCCRefund">LCC Refund</option>
                        <option value="checkIn">Check-in</option>
                        <option value="Custom">Custom</option>
                    </select>
                    <textarea id="solution2" class="editable-solution"></textarea>
                 </li>
                <li>Segments Removed: 
                    <select id="Segments Removed2">
                        <option value="No">No</option>
                        <option value="Yes">Yes</option>
                    </select>
                </li>
                <li>No sc Trivial Minor Major Critical Critical/Mct causing/MCT
                <li>Alternatives: <textarea id="alternatives2"></textarea></li>
                <li>ENDO: <textarea id="endo2"></textarea></li>
                <li>OTRS: <textarea id="otrs2"></textarea></li>
                <li>ET: <textarea id="et2"></textarea></li>
            </ul>
        </div>
    </div>

    <script>
        const chatScripts = [
            "Hello, xxx my name is Rutwej. Please give me a moment to review your request.",
            "Hello, xxx my name is Rutwej. How may I help you with your booking?",
            "Please don't worry I'll make sure to document everything so you won't need to repeat any information. Thank you for your cooperation!",
            "If I understand correctly, you are looking for a refund. Is that correct?",
            "If I understand correctly, you are looking for a rebooking. Is that correct?",
            "How would you like to proceed? Please give me confirmation.",
            "//pax idle//gave warning//chat disconnected//email sent to pax with details",
            "Please do not worry and I have done all the needful things on your booking and I totally understand your situation right now. I request you to wait.",
            "Thank you for the confirmation, let me check what best can be done.",
            "Thank you for the information, let me check what best can be done.",
            "Let me check what best can be done.",
            "Please find the updated changes made to your Travel Itinerary below:",
            "This is what you are referring to?",
            "I hope you understand what I am trying to say.",
            "Do you have more questions?",
            "Let me go out of my way and do something which will benefit you. Please give me a moment.",
            "Does that sound good to you?",
            "Wonderful! Let’s proceed.",
            "That’s great to hear!",
            "Perfect!",
            "Fantastic!",
            "Please check your email as the chat ends, as I will be sending all the details to your email.",
            "Please keep monitoring your email as you will be notified once we receive the response from the airlines.",
            "I am glad that I was able to resolve your query today and hope all your questions are answered.",
            "We need customers like you. Thank you so much for your patience and understanding. I really appreciate that.",
            "Perfect!",
            "It is my pleasure.",
            "Apart from this, is there anything else I can help you with?",
            "You have been chatting with Rutwej. It was my pleasure assisting you. Thank you for being a valued customer, and I look forward to serving you again.",
            "Thank you for contacting us. Have a nice day!",
            "I don't want to rush you, but the chat has been inactive for 2 minutes, I didn't receive a response, and I want to make sure we're still connected. Let me know by responding to the chat. Please note that this chat will end in 3 minutes if you do not respond.",
            "I still haven't received a response, and it seems that you are no longer connected. This chat will now be closed. If you need further assistance, please start a new chat. Thank you."
        ];

        function openChatScriptsPopup() {
            const modal = document.getElementById("chatScriptsModal");
            const list = document.getElementById("chatScriptsList");
            list.innerHTML = ""; // Clear previous content

            chatScripts.forEach(script => {
                let div = document.createElement("div");
                div.className = "text-line";
                div.innerHTML = `<span>${script}</span> <button class="copy-btn" onclick="copyText(this)">Copy</button>`;
                list.appendChild(div);
            });

            modal.style.display = "block"; // Show the modal
        }

        function closeChatScriptsPopup() {
            document.getElementById("chatScriptsModal").style.display = "none";
        }

        function copyText(button) {
            const text = button.parentElement.querySelector("span").innerText;
            navigator.clipboard.writeText(text).then(() => {
                button.innerText = "Copied!";
                setTimeout(() => button.innerText = "Copy", 2000);
            });
        }

        const templates = {
            modifyOrder: "Pax connected via Chat due to SC // checked and informed about the xxxx SC // pax wanted Refund // checked docs and refund permitted // hence removed segments from GDS // modify order done // Cxl email sent // explained the refund procedure to pax // pax okay",
            rebookingOrder: "Pax connected via Chat due to SC // checked and informed about the xxxx SC // pax wanted to rebook // checked availability of the flights and offered the same to pax // pax okay with that // as per docs rebooking allowed // hence removed old segments // new segments added and confirmed // rebooking wizard filled // CNF email sent // explained the rebooking procedure to pax // pax okay",
            supportRebooking: "Pax connected via Chat due to SC // checked and informed about the xxxx SC // pax wanted to rebook // checked for an alt and available // however auth required // hence placing on support // explained the rebooking procedure to pax // pax okay",
            supportRefund: "Pax connected via Chat due to SC // checked and informed about the xxxx SC // pax wanted refund // checked docs and auth required // hence placing on support // explained the refund procedure to pax // pax okay",
            acceptChanges: "Pax connected via Chat due to SC // As checked xxxx sc // Pax ok with the changes // hence accepted the changes // confirmation email sent to pax // pax ok // nfat",
            paxIdle: "Pax connected via Chat due to SC // As checked xxxx sc // Pax idle // Chat/ Call disconnected // nfat",
            sameDayTravel: "Pax connected via Chat due to SC// checked and informed about the xxxx SC // advised pax to speak with the YY directly as Travel within 24 hours as they are in a better position to assist // they have the access to make the changes // pax okay",
            VIofferedRefund: "Pax connected via Chat due to SC// checked and informed about the xxxx SC // pax wanted to rebook // informed pax we cant rebook as departure is within 24 Hours offered refund // pax wanted refund // modify order done // CNF email sent // explained the refund procedure to pax // pax okay",
            refundStatus: "Pax connected via Chat due to SC// checked and informed about the Major SC // pax wanted to know the refund status // Advised pax to wait // as the request has been already escalated // explain refund timelines // pax okay // Chatended",
            rebookingStatus: "Pax connected via Chat due to SC// checked and informed about the Major SC // pax wanted to know the rebooking status // informed pax its already on support and we haven't hear from the airlines yet // advised pax to wait",
            enquiryRebooking: "Pax connected via Chat due to SC// checked and informed about the Trivial SC // pax wanted rebooking // asked for confirmation // pax idle // gave warning // chat disconnected // email sent to pax with details",
            enquiryRefund: "Pax connected via Chat due to SC// checked and informed about the Trivial SC // pax wanted refund // asked for confirmation // pax idle // gave warning // chat disconnected // email sent to pax with details",
            LCCRefund: "Pax connected via Chat due to SC// checked and informed about the Critical SC // pax wanted refund // unable to initiate refund // hence placing on support // explained the refund procedure to pax // pax okay",
            checkIn: "Pax connected via Chat due to SC// checked and informed about the Critical sc / Mct // pax wanted rebooking informed ticket is in checked-in status asked pax to contact YY to Check-out and contact us back // pax okay Chat ended",
            Custom: "Pax chatted in due to SC // checked and informed about the XXXX SC // pax wanted"
        };

        const queryTemplates = {
            Refund: "Pax contacted regarding a refund request.",
            Rebooking: "Pax contacted regarding a rebooking request.",
            RefundStatus: "Pax inquired about the status of their refund.",
            RebookingStatus: "Pax inquired about the status of their rebooking.",
            SCConfirmation: "Pax requested confirmation regarding a service change (SC).",
            FlightDetails: "Pax requested details about their flight.",
        };

        function applyTemplate(section, templateKey) {
            const solutionTextarea = document.getElementById(`solution${section}`);
            if (templateKey && templates[templateKey]) {
                solutionTextarea.value = templates[templateKey];
            } else {
                solutionTextarea.value = "";
            }
        }

        function applyQueryTemplate(section, queryKey) {
            const queryTextarea = document.getElementById(`query${section}`);
            if (queryKey && queryTemplates[queryKey]) {
                queryTextarea.value = queryTemplates[queryKey];
            } else {
                queryTextarea.value = "";
            }
        }

        function confirmClear(section) {
            if (confirm("Are you sure you want to clear notes for Interaction " + section + "?")) {
                clearNotes(section);
            }
        }

        function clearNotes(section) {
            document.querySelectorAll(`#interactionId${section}, #orderNumber${section}, #contactPerson${section}, #query${section}, #solution${section}, #alternatives${section}, #endo${section}, #Segments Removed${section}, #otrs${section}, #et${section}`).forEach(field => field.value = "");
            document.getElementById(`pnrList${section}`).innerHTML = "";
        }

        function addPNR(section) {
            let pnrList = document.getElementById(`pnrList${section}`);
            if (pnrList.children.length < 10) {
                let div = document.createElement('div');
                div.className = "pnr-container";
                div.innerHTML = `
                    PNR: <input type="text" class="pnr">
                    SC Type: 
                    <select class="scType">
                        <option value=" "> </option>                        
                        <option value="NO SC">NO SC</option>                        
                        <option value="Major">Major</option>
                        <option value="Critical">Critical</option>
                        <option value="Minor">Minor</option>
                        <option value="Trivial">Trivial</option>
                        <option value="Critical Sc/Mct">Critical Sc/Mct</option>
                        <option value="Major SC Causing MCT">Major SC Causing MCT</option>
                        <option value="Minor SC Causing MCT">Minor SC Causing MCT</option>
                        <option value="Trivial SC Causing MCT">Trivial SC Causing MCT</option>
                    </select>
                `;
                pnrList.appendChild(div);
            }
        }

        function copyToClipboard(section) {
            let text = "";
            const fields = [
                { label: "Interaction ID", id: `interactionId${section}` },
                { label: "Order Number", id: `orderNumber${section}` },
                { label: "Contact Person", id: `contactPerson${section}` },
                { label: "Segments Removed", id: `Segments Removed${section}` }
            ];

            fields.forEach(field => {
                let value = document.getElementById(field.id).value.trim();
                if (value) text += `\u2022 ${field.label}: ${value}\n`;
            });

            document.querySelectorAll(`#pnrList${section} .pnr-container`).forEach(pnrDiv => {
                let pnr = pnrDiv.querySelector('.pnr').value.trim();
                let scType = pnrDiv.querySelector('.scType').value.trim();
                if (pnr && scType) text += `\u2022 PNR: ${pnr}, SC Type: ${scType}\n`;
            });

            const remainingFields = [
                { label: "Query", id: `query${section}` },
                { label: "Solution", id: `solution${section}` },
                { label: "Alternatives", id: `alternatives${section}` },
                { label: "ENDO", id: `endo${section}`  },
                { label: "OTRS", id: `otrs${section}` },
                { label: "ET", id: `et${section}` }
                
            ];

            remainingFields.forEach(field => {
                let value = document.getElementById(field.id).value.trim();
                if (value) text += `\u2022 ${field.label}: ${value}\n`;
            });

            if (text) {
                navigator.clipboard.writeText(text).then(() => {
                    alert(`Notes copied for Interaction ${section}!`);
                }).catch(err => {
                    console.error("Failed to copy: ", err);
                });
            } else {
                alert(`No notes to copy for Interaction ${section}!`);
            }
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            if (currentTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'light');
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        }
    </script>
</body>
</html>
